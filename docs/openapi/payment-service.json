              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not an admin (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No such payout at your insurer (PAYMENT_NOT_FOUND)",
            "content" : {
              "*/*" : {
