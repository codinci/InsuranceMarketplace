          "name" : "Idempotency-Key",
          "in" : "header",
          "description" : "Unique per attempt, 1 to 80 characters",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PayRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "The attempt's result: SUCCEEDED, or FAILED when the mock declined it",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Missing Idempotency-Key (IDEMPOTENCY_KEY_REQUIRED) or invalid body (VALIDATION_FAILED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not a customer (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No such payment of yours (PAYMENT_NOT_FOUND)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Already paid (PAYMENT_ALREADY_PAID), cancelled for non-payment (PAYMENT_EXPIRED), key reused for another payment (IDEMPOTENCY_KEY_REUSED), or a concurrent change (CONFLICT)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
