    "/api/v1/payments/{id}/pay" : {
      "post" : {
        "tags" : [ "Payments" ],
        "summary" : "Pay a premium (mock checkout)",
        "description" : "One attempt per Idempotency-Key. A repeat with the same key returns the first result. A failed attempt can be paid again with a new key. Success activates the policy once policy-service consumes PremiumPaid.",
        "operationId" : "pay",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
