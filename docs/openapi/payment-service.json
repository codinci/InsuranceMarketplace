{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "payment-service",
    "description" : "Premium payments with a mock checkout, and the payment ledger (M4b).",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "Payments",
    "description" : "Premium payments for the caller's own policies (mock checkout)."
  }, {
    "name" : "Internal",
    "description" : "Service-to-service endpoints (SERVICE token only). Not published through the gateway."
  }, {
    "name" : "Refunds",
    "description" : "Find and retry premium refunds (admin)."
  }, {
    "name" : "Payouts",
    "description" : "Find and retry claim payouts (admin)."
  } ],
  "paths" : {
    "/internal/payments" : {
      "post" : {
        "tags" : [ "Internal" ],
        "summary" : "Create the premium for a policy",
        "description" : "Idempotent on the Idempotency-Key header. policy-service sends the policy id, so a retried purchase gets the same payment back.",
        "operationId" : "create",
        "parameters" : [ {
          "name" : "Idempotency-Key",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateIntentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Payment created, or the earlier one returned",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Missing Idempotency-Key (IDEMPOTENCY_KEY_REQUIRED) or invalid body (VALIDATION_FAILED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not a SERVICE token (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "The key was used for a different request (IDEMPOTENCY_KEY_REUSED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/payments/{id}/retry-refund" : {
      "post" : {
        "tags" : [ "Refunds" ],
        "summary" : "Retry a failed refund",
        "description" : "One attempt per Idempotency-Key. A repeat with the same key returns the first result. Only a refund in FAILED can be retried. Each attempt sends RefundSucceeded or RefundFailed.",
        "operationId" : "retry",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "Idempotency-Key",
          "in" : "header",
          "description" : "Unique per attempt, 1 to 80 characters",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The attempt's result: SUCCEEDED or FAILED",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Missing Idempotency-Key (IDEMPOTENCY_KEY_REQUIRED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not an admin (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No such refund at your insurer (PAYMENT_NOT_FOUND)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Not failed (REFUND_NOT_RETRYABLE), key reused for another payment (IDEMPOTENCY_KEY_REUSED), or a concurrent change (CONFLICT)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
