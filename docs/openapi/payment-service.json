  "components" : {
    "schemas" : {
      "CreateIntentRequest" : {
        "type" : "object",
        "description" : "Sent by policy-service (SERVICE token only). The amount is the premium the server quoted; this service never reprices it.",
        "properties" : {
          "policyId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "The policy this premium is for"
          },
          "policyNumber" : {
            "type" : "string",
            "example" : "POL-ACACIA-2026-000001",
            "maxLength" : 60,
            "minLength" : 0
          },
          "insurerId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "holderUserId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "The policy holder, who is the only customer who may pay"
          },
          "amount" : {
            "type" : "number",
            "example" : 12500.0,
            "minimum" : 0.01
          },
          "currency" : {
            "type" : "string",
            "example" : "KES",
            "pattern" : "[A-Z]{3}"
          }
        },
        "required" : [ "amount", "currency", "holderUserId", "insurerId", "policyId", "policyNumber" ]
      },
      "PaymentResponse" : {
        "type" : "object",
        "description" : "A premium payment and where it stands.",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Payment id, used in POST /api/v1/payments/{id}/pay"
          },
          "status" : {
            "type" : "string",
            "description" : "PENDING, SUCCEEDED, FAILED or EXPIRED",
            "example" : "PENDING"
          },
          "referenceType" : {
            "type" : "string",
            "description" : "POLICY (a premium), CLAIM (a payout) or REFUND",
            "example" : "POLICY"
          },
          "referenceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "referenceNumber" : {
            "type" : "string",
            "example" : "POL-ACACIA-2026-000001"
          },
          "amount" : {
            "type" : "number",
            "example" : 12500.0
          },
          "currency" : {
            "type" : "string",
            "example" : "KES"
          },
          "providerRef" : {
            "type" : "string",
            "description" : "The mock provider's reference, once a payment succeeds"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "PayRequest" : {
        "type" : "object",
        "description" : "Mock checkout options. Only for testing: the real provider has no such switch.",
        "properties" : {
          "simulate" : {
            "type" : "string",
            "description" : "MOCK ONLY. FAIL makes the mock provider decline this attempt, so the failure path can be exercised. Leave out for a successful payment.",
            "enum" : [ "FAIL" ],
            "pattern" : "FAIL"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
