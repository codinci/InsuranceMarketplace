{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "policy-service",
    "description" : "Catalogue: insurers, plans, import and publishing. Policies from M4.",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "Profile",
    "description" : "The calling customer's own policy-holder details."
  }, {
    "name" : "Catalogue",
    "description" : "Browse insurers and plans. Public: no token needed (PLAN 4)."
  }, {
    "name" : "Catalogue admin",
    "description" : "Insurers and plan import. Insurer admins act only on their own insurer."
  } ],
  "paths" : {
    "/api/v1/me/profile" : {
      "get" : {
        "tags" : [ "Profile" ],
        "summary" : "Get my profile",
        "description" : "CUSTOMER only. The national ID is masked.",
        "operationId" : "get",
        "responses" : {
          "200" : {
            "description" : "The profile",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid access token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not a customer (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No profile yet (PROFILE_NOT_FOUND)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      },
      "put" : {
        "tags" : [ "Profile" ],
        "summary" : "Create or update my profile",
        "description" : "Needed before buying a policy. The national ID is stored encrypted.",
        "operationId" : "put",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ProfileRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "The saved profile",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid details (VALIDATION_FAILED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid access token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not a customer (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/admin/plans/{planId}/retire" : {
      "post" : {
        "tags" : [ "Catalogue admin" ],
        "summary" : "Retire a published plan",
        "description" : "Takes it off sale. Existing policies keep their own snapshot.",
        "operationId" : "retire",
        "parameters" : [ {
          "name" : "planId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Retired",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid access token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not an admin (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No such plan, or not yours (PLAN_NOT_FOUND)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Not published (PLAN_NOT_PUBLISHED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/admin/plans/{planId}/publish" : {
      "post" : {
        "tags" : [ "Catalogue admin" ],
        "summary" : "Publish a draft",
        "description" : "Makes the version immutable and puts it on sale. An older published version of the same plan is retired in the same step (D33).",
        "operationId" : "publish",
        "parameters" : [ {
          "name" : "planId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Published",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid access token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not an admin (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No such plan, or not yours (PLAN_NOT_FOUND)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Not a draft, or a newer version is published (PLAN_NOT_DRAFT, NEWER_VERSION_PUBLISHED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminPlanResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/admin/insurers" : {
      "post" : {
        "tags" : [ "Catalogue admin" ],
        "summary" : "Create an insurer",
        "description" : "Platform admin only (PLAN 4).",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateInsurerRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Insurer created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InsurerResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid code or name (VALIDATION_FAILED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InsurerResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid access token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InsurerResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not an admin, or an insurer admin (FORBIDDEN, PLATFORM_ADMIN_REQUIRED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InsurerResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Code already used (INSURER_CODE_TAKEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InsurerResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/admin/insurers/{insurerId}/plans/import" : {
      "post" : {
        "tags" : [ "Catalogue admin" ],
        "summary" : "Import a plan document",
        "description" : "Validates the document against the schema and the semantic rules (docs/catalogue-schema.md). With dryRun=true nothing is stored. Otherwise a new version is stored as DRAFT, and an existing DRAFT of the same version is replaced (D34). Maximum 256 KB.",
        "operationId" : "importPlan",
        "parameters" : [ {
          "name" : "insurerId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "dryRun",
          "in" : "query",
          "description" : "Validate only; store nothing.",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        } ],
        "requestBody" : {
          "description" : "A plan document, schema version 1.",
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "object"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Valid (dry run) or a draft replaced",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "A new draft version stored",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid access token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not an admin (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No such insurer, or not yours (INSURER_NOT_FOUND)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "That version is published or retired (PLAN_VERSION_IMMUTABLE)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "413" : {
            "description" : "Document too large (PLAN_TOO_LARGE)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "422" : {
            "description" : "Invalid document, every problem in errors (PLAN_INVALID), or the document names another insurer (INSURER_MISMATCH)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/plans/{planId}" : {
      "get" : {
        "tags" : [ "Catalogue" ],
        "summary" : "Show a plan's terms",
        "description" : "Modules, options, benefits, limits, waiting rules, exclusions and cancellation of a published plan. Prices come from quotes.",
        "operationId" : "plan",
        "parameters" : [ {
          "name" : "planId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The plan's terms",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PlanDetailResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Not a valid id (VALIDATION_FAILED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PlanDetailResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No such published plan (PLAN_NOT_FOUND)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PlanDetailResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/v1/insurers" : {
      "get" : {
        "tags" : [ "Catalogue" ],
        "summary" : "List insurers",
        "description" : "Active insurers, by name.",
        "operationId" : "insurers",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "One page of insurers",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseInsurerResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Bad paging (VALIDATION_FAILED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseInsurerResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/v1/insurers/{code}/plans" : {
      "get" : {
        "tags" : [ "Catalogue" ],
        "summary" : "List an insurer's plans on sale",
        "description" : "Published plans whose sale period includes today, by name.",
        "operationId" : "plans",
        "parameters" : [ {
          "name" : "code",
          "in" : "path",
          "description" : "Insurer code",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "ACACIA"
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "One page of plans",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponsePlanSummaryResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Bad paging (VALIDATION_FAILED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponsePlanSummaryResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No such insurer (INSURER_NOT_FOUND)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponsePlanSummaryResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/v1/admin/plans" : {
      "get" : {
        "tags" : [ "Catalogue admin" ],
        "summary" : "List plan versions",
        "description" : "Newest first. An insurer admin sees only their own insurer; a platform admin may filter by insurerId.",
        "operationId" : "list",
        "parameters" : [ {
          "name" : "status",
          "in" : "query",
          "description" : "DRAFT, PUBLISHED or RETIRED",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "DRAFT|PUBLISHED|RETIRED"
          }
        }, {
          "name" : "insurerId",
          "in" : "query",
          "description" : "Platform admin only: one insurer",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "One page of plan versions",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAdminPlanResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Bad paging or filter (VALIDATION_FAILED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAdminPlanResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No valid access token (UNAUTHENTICATED)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAdminPlanResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not an admin (FORBIDDEN)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAdminPlanResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "The insurerId filter names an insurer you cannot see (INSURER_NOT_FOUND)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAdminPlanResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ProfileRequest" : {
        "type" : "object",
        "description" : "The policy holder's details. Email stays with auth-service.",
        "properties" : {
          "firstName" : {
            "type" : "string",
            "example" : "Amina",
            "maxLength" : 100,
            "minLength" : 0
          },
          "lastName" : {
            "type" : "string",
            "example" : "Otieno",
            "maxLength" : 100,
            "minLength" : 0
          },
          "dateOfBirth" : {
            "type" : "string",
            "format" : "date",
            "example" : "1990-06-15"
          },
          "sex" : {
            "type" : "string",
            "enum" : [ "FEMALE", "MALE" ]
          },
          "nationalId" : {
            "type" : "string",
            "description" : "Upper-case letters and digits, 5 to 20. Stored encrypted.",
            "example" : "A1234567",
            "minLength" : 1,
            "pattern" : "^[A-Z0-9]{5,20}$"
          },
          "phone" : {
            "type" : "string",
            "example" : "+254700000000",
            "minLength" : 1,
            "pattern" : "^\\+?[0-9]{9,15}$"
          }
        },
        "required" : [ "dateOfBirth", "firstName", "lastName", "nationalId", "phone", "sex" ]
      },
      "ProfileResponse" : {
        "type" : "object",
        "description" : "The policy holder's details. The national ID is masked.",
        "properties" : {
          "firstName" : {
            "type" : "string"
          },
          "lastName" : {
            "type" : "string"
          },
          "dateOfBirth" : {
            "type" : "string",
            "format" : "date"
          },
          "sex" : {
            "type" : "string",
            "enum" : [ "FEMALE", "MALE" ]
          },
          "nationalIdMasked" : {
            "type" : "string",
            "description" : "Only the last three characters.",
            "example" : "***567"
          },
          "phone" : {
            "type" : "string"
          }
        }
      },
      "AdminPlanResponse" : {
        "type" : "object",
        "description" : "A plan version as staff see it.",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Plan version id."
          },
          "insurerId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Owning insurer."
          },
          "productId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Owning product."
          },
          "code" : {
            "type" : "string",
            "example" : "STANDARD"
          },
          "name" : {
            "type" : "string",
            "example" : "Acacia Standard"
          },
          "version" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Plan version number.",
            "example" : 1
          },
          "status" : {
            "type" : "string",
            "description" : "DRAFT, PUBLISHED or RETIRED.",
            "example" : "DRAFT"
          },
          "saleFrom" : {
            "type" : "string",
            "format" : "date",
            "example" : "2026-01-01"
          },
          "saleTo" : {
            "type" : "string",
            "format" : "date",
            "description" : "Open-ended when null."
          },
          "currency" : {
            "type" : "string",
            "example" : "KES"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "publishedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "retiredAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "CreateInsurerRequest" : {
        "type" : "object",
        "description" : "A new insurer on the marketplace.",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Upper-case code, unique on the platform. Plan documents must use it.",
            "example" : "MVULE",
            "minLength" : 1,
