# Copy to .env and replace every value. .env is git-ignored; this file is committed.
# Local development only. Never reuse these values anywhere else.
POSTGRES_PASSWORD=change-me-postgres
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
# Host port for the API gateway, the only published service (PLAN 12). Change it if another program uses 8080.
GATEWAY_HOST_PORT=8080
# auth-service (M1). The private key is PKCS#8 DER in base64, on one line (see docs/runbook.md, "Signing key").
AUTH_JWT_PRIVATE_KEY_BASE64=
# First platform admin, created on first start when this email does not exist yet.
AUTH_SEED_PLATFORM_ADMIN_EMAIL=
AUTH_SEED_PLATFORM_ADMIN_PASSWORD=change-me-admin-password
# Password for the Redis service used by the gateway's rate limits. Never published to the host.
REDIS_PASSWORD=change-me-redis-password
# policy-service: key that encrypts personal data at rest (D37, ADR-012). 32 random bytes, base64. See docs/runbook.md.
POLICY_FIELD_KEY_BASE64=
POLICY_FIELD_KEY_ID=policy-key-1
# Shared secret policy-service uses to get SERVICE tokens from auth-service (ADR-014). Any long random string.
SERVICE_SECRET_POLICY_SERVICE=change-me-policy-service-secret
# Shared secret claim-service uses to get SERVICE tokens from auth-service for the policy fallback (ADR-014, M5a).
SERVICE_SECRET_CLAIM_SERVICE=change-me-claim-service-secret
