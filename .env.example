# Copy to .env and replace every value. .env is git-ignored; this file is committed.
# Local development only. Never reuse these values anywhere else.
POSTGRES_PASSWORD=change-me-postgres
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
# Host port for hello-service (the gateway takes 8080 from M2). Change it if another program uses 8080.
HELLO_HOST_PORT=8080
